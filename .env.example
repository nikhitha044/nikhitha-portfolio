# Copy this file to .env.local (for local dev) or configure these in your hosting
# provider's dashboard (e.g. Vercel Project Settings -> Environment Variables).
# Never commit real values for these.

# Server-side only — used by api/contact.ts to send email via Resend.
# Get this from https://resend.com after creating an account and an API key.
# Required for the contact form to actually send email; without it, the form
# will show a friendly "not configured yet" error.
RESEND_API_KEY=

# Server-side only — the inbox that receives contact form submissions.
# Optional: defaults to nikhithajangam04@gmail.com in api/contact.ts if unset.
CONTACT_TO_EMAIL=

# Client-side (Vite) — enables the analytics stub in src/lib/analytics.ts.
# Optional: defaults to disabled. The app works fully without this set; when
# unset or not "true", trackEvent() is a complete no-op.
VITE_ANALYTICS_ENABLED=
